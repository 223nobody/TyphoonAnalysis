# ============================================
# 台风分析系统 - 环境变量配置示例
# 复制此文件为 .env 并修改相应配置
# ============================================

# 应用配置
APP_NAME=台风分析系统
APP_VERSION=2.0.0
DEBUG=True
SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置 (SQLite - 开发环境)
DATABASE_URL=sqlite+aiosqlite:///./typhoon_analysis.db

# 数据库配置 (PostgreSQL - 生产环境，可选)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/typhoon_analysis

# Qwen/GLM 服务配置（统一使用 aiping.cn 接口）
# 从 https://aiping.cn 获取 API 密钥
AI_API_KEY=your-ai-api-key-here
AI_API_BASE_URL=https://aiping.cn/api/v1

# DeepSeek 专用 API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 深度思考模式兼容配置（可选；未配置 DEEPSEEK_API_KEY 时使用）
AI_API_KEY_THINKING=your-deepseek-api-key-here
AI_API_BASE_URL_THINKING=https://dpapi.cn/v1

# 视觉模型配置（可选）
AI_API_KEY_VL=your-dashscope-api-key-here
AI_API_BASE_URL_VL=https://dashscope.aliyuncs.com/api/v1

# AI 模型配置
DEEPSEEK_MODEL_THINKING=deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-flash
GLM_MODEL=glm-4-plus
QWEN_TEXT_MODEL=Qwen3-235B-A22B
QWEN_VL_MODEL=qwen-vl-max-latest

# AI 性能与输出质量配置
AI_REPORT_MAX_TOKENS=4096
AI_REPORT_TIMEOUT=150
AI_REPORT_MAX_RETRIES=2
AI_REPORT_RETRY_DELAY=1.5
AI_REPORT_TEMPERATURE=0.45
AI_REPORT_TOP_P=0.9
AI_CHAT_SIMPLE_MAX_TOKENS=2400
AI_CHAT_COMPLEX_MAX_TOKENS=4096
AI_CHAT_THINKING_MAX_TOKENS=6144
AI_CHAT_TIMEOUT=75
AI_CHAT_THINKING_TIMEOUT=180
AI_CHAT_TEMPERATURE=0.65
AI_CHAT_TOP_P=0.9
AI_CHAT_PRESENCE_PENALTY=0.05
AI_CHAT_FREQUENCY_PENALTY=0.1
AI_VL_IMAGE_MAX_TOKENS=2400
AI_VL_IMAGE_TIMEOUT=160
AI_VL_IMAGE_MAX_RETRIES=2
AI_VL_IMAGE_TEMPERATURE=0.2
AI_VL_VIDEO_MAX_TOKENS=2400
AI_VL_VIDEO_FRAME_MAX_TOKENS=1200
AI_VL_VIDEO_TIMEOUT=240
AI_VL_VIDEO_MAX_RETRIES=2
AI_VL_VIDEO_TEMPERATURE=0.55
AI_VL_RETRY_DELAY=1.5

# ASR 模型配置（可选）
# 本地模型路径，留空则使用默认路径或从 HuggingFace 下载
# QWEN_ASR_MODEL_PATH=./data/asr_model/Qwen3-ASR-0.6B

# 爬虫配置
CRAWLER_ENABLED=True
CRAWLER_INTERVAL_MINUTES=10
CRAWLER_START_ON_STARTUP=True

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 阿里云 OSS 配置（可选，用于云存储）
# OSS_ACCESS_KEY_ID=your-access-key-id
# OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_BUCKET_NAME=your-bucket-name
# OSS_REGION=oss-cn-hangzhou
# OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
